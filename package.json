{
  "name": "emergency-medical-lockbox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc && npx vite build",
    "lint": "npx tsc --noEmit",
    "preview": "vite preview",
    "compile:contract": "compact compile contract/lockbox.compact contract/",
    "proof-server": "docker run -p 6300:6300 midnightntwrk/proof-server:latest midnight-proof-server --network testnet",
    "deploy:contract": "npx tsx scripts/deploy-contract.ts",
    "deploy:onchain": "npx tsx scripts/deploy-onchain.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "^0.1.15",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
